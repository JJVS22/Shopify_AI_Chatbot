CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY
# Full OAuth callback URI for the customer login flow.
# In production this MUST match the deployed app URL and the
# [customer_authentication] redirect_uris in your shopify.app.<config>.toml.
# Defaults to APP_URL + "/auth/callback" when unset.
# REDIRECT_URL=https://your-app.example.com/auth/callback
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID

# DeepSeek (chat LLM)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# Optional: override the DeepSeek API base URL (defaults to https://api.deepseek.com/v1)
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# Replicate (2D try-on + 3D generation)
REPLICATE_API_TOKEN=r8_YOUR_REPLICATE_TOKEN

# Optional: pin or override Replicate models
# REPLICATE_IMAGE_EDIT_MODEL=prunaai/p-image-edit
# REPLICATE_IMAGE_TO_3D_MODEL=firtoz/trellis:e8f6c45206993f297372f5436b90350817bd9b4a0d52d2a76df50c1c8afa2b3c

# Optional: provider selection (defaults work for this app)
# LLM_PROVIDER=deepseek
# IMAGE_EDIT_PROVIDER=replicate-p-image-edit
# IMAGE_TO_3D_PROVIDER=replicate-trellis

# Optional: where 2D/3D outputs are saved on disk
# TRYON_RESULTS_DIR=storage/tryon-results

# Public base URL of the backend (used to build absolute viewer/image URLs AND
# as the default OAuth redirect base for the customer login link).
# Must be HTTPS and reachable by the browser. This is the value merchants must
# also enter as the "App API Base URL" in the theme editor block settings.
# APP_URL=https://your-app.example.com
